# ==========================================
# Campus Assistant Backend - Environment Template
# ==========================================
# Copy this file to .env and replace placeholder values with your configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Application Server
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local example: mongodb://127.0.0.1:27017/campus_assistant
# Atlas format: mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campus_assistant

# JWT Authentication
# In production, use a strong, cryptographically secure 32+ character secret
JWT_SECRET=your-jwt-secret-minimum-32-chars-long-placeholder

# Admin API Key (guards /api/tickets and /api/evaluation)
ADMIN_API_KEY=your-admin-api-key-placeholder

# AI Service Configuration
# Local mock server: http://127.0.0.1:8000
# Hugging Face endpoint: https://router.huggingface.co/hf-inference/models/ORG/MODEL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_CHAT_PATH=/api/v1/chat
AI_SERVICE_HEALTH_PATH=/api/v1/health
AI_HEALTH_URL=http://127.0.0.1:8000/api/v1/health
AI_SERVICE_TIMEOUT_MS=30000

# Hugging Face / AI Service Token (Optional if local mock AI is used)
# Format: your Hugging Face User Access Token
AI_SERVICE_API_KEY=your-huggingface-token-or-service-api-key-placeholder
HF_TOKEN=your-huggingface-token-placeholder

# Mock AI switch (set to true to run offline without an external AI service)
USE_MOCK_AI=true
REQUIRE_SOURCES=true
IT_KEYWORD_RULE=true

# CORS and Proxy configuration
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://mycampus.edu)
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Multi-Tenant & Demo Seeding
DEFAULT_ORG_ID=bennett-university
DEMO_STUDENT_PASSWORD=your-demo-student-password-placeholder
